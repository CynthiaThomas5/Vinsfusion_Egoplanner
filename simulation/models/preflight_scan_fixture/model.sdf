<sdf version="1.9">
  <model name="preflight_scan_fixture">
    <self_collide>false</self_collide>
    <link name="base">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="slide_x">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="lift_z">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="yaw_stage">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="hand">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="anchor" type="fixed">
      <parent>world</parent>
      <child>base</child>
    </joint>
    <joint name="x" type="prismatic">
      <parent>base</parent>
      <child>slide_x</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-2.5</lower>
          <upper>1.5</upper>
          <effort>200</effort>
          <velocity>0.4</velocity>
        </limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>x</joint_name>
      <topic>/preflight_scan/x</topic>
      <p_gain>500</p_gain>
      <i_gain>10</i_gain>
      <d_gain>20</d_gain>
      <i_max>100</i_max>
      <i_min>-100</i_min>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>
    <joint name="z" type="prismatic">
      <parent>slide_x</parent>
      <child>lift_z</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.0</upper>
          <effort>200</effort>
          <velocity>0.4</velocity>
        </limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>z</joint_name>
      <topic>/preflight_scan/z</topic>
      <p_gain>1000</p_gain>
      <i_gain>50</i_gain>
      <d_gain>100</d_gain>
      <i_max>100</i_max>
      <i_min>-100</i_min>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>
    <joint name="yaw" type="revolute">
      <parent>lift_z</parent>
      <child>yaw_stage</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-7</lower>
          <upper>7</upper>
          <effort>200</effort>
          <velocity>0.4</velocity>
        </limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>yaw</joint_name>
      <topic>/preflight_scan/yaw</topic>
      <p_gain>100</p_gain>
      <i_gain>10</i_gain>
      <d_gain>20</d_gain>
      <i_max>100</i_max>
      <i_min>-100</i_min>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>
    <joint name="pitch" type="revolute">
      <parent>yaw_stage</parent>
      <child>hand</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>200</effort>
          <velocity>0.4</velocity>
        </limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>pitch</joint_name>
      <topic>/preflight_scan/pitch</topic>
      <p_gain>150</p_gain>
      <i_gain>10</i_gain>
      <d_gain>20</d_gain>
      <i_max>100</i_max>
      <i_min>-100</i_min>
      <cmd_max>200</cmd_max>
      <cmd_min>-200</cmd_min>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>hand</parent_link>
      <child_model>x500_d435i_0</child_model>
      <child_link>base_link</child_link>
      <detach_topic>/preflight_scan/detach</detach_topic>
      <attach_topic>/preflight_scan/attach</attach_topic>
      <output_topic>/preflight_scan/attachment</output_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/preflight_scan/joints</topic>
    </plugin>
  </model>
</sdf>
