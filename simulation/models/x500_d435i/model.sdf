<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_d435i">
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <include merge="true">
      <uri>model://d435i</uri>
      <pose>0.12 0 0.08 0 0 0</pose>
    </include>
    <joint name="d435i_mount" type="fixed">
      <parent>base_link</parent>
      <child>d435i_link</child>
      <pose relative_to="base_link">0.12 0 0.08 0 0 0</pose>
    </joint>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>d435i_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_topic>/debug_truth/base_odometry</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
