Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: __ODOM_FRAME__
    Background Color: 30; 30; 35
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1.0
    Plane Cell Count: 30
  - Class: rviz_default_plugins/PointCloud2
    Name: Inflated Occupancy Map
    Enabled: true
    Topic:
      Value: /drone___DRONE_ID___grid/grid_map/occupancy_inflate
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Size (m): 0.1
    Style: Boxes
    Color Transformer: AxisColor
    Axis: Z
    Autocompute Value Bounds:
      Value: true
      Min Value: -1
      Max Value: 3
    Use rainbow: true
    Color: 60; 200; 240
  - Class: rviz_default_plugins/Path
    Name: EGO Planned Curve
    Enabled: true
    Topic:
      Value: /visualization/ego/planned_path
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color: 255; 90; 70
    Line Style: Lines
    Line Width: 0.05
    Pose Style: None
    Buffer Length: 1
  - Class: rviz_default_plugins/Path
    Name: VINS Actual Path
    Enabled: true
    Topic:
      Value: /visualization/ego/actual_path
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color: 70; 220; 255
    Line Style: Lines
    Line Width: 0.04
    Pose Style: None
    Buffer Length: 1
  - Class: rviz_default_plugins/Marker
    Name: Accepted Target and Yaw
    Enabled: true
    Topic:
      Value: /visualization/ego/goal
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Queue Size: 10
  - Class: rviz_default_plugins/Marker
    Name: Provisional Clearance Envelope
    Enabled: true
    Topic:
      Value: /visualization/ego/envelope
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Queue Size: 10
  - Class: rviz_default_plugins/Marker
    Name: Localization Map and Planner Status
    Enabled: true
    Topic:
      Value: /visualization/ego/status
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Queue Size: 10
  - Class: rviz_common/Group
    Name: EGO Debug Layers
    Enabled: false
    Displays:
    - Class: rviz_default_plugins/Marker
      Name: Global Reference
      Enabled: true
      Topic:
        Value: /visualization/ego/global_reference
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Queue Size: 10
    - Class: rviz_default_plugins/Marker
      Name: Initial Candidates
      Enabled: true
      Topic:
        Value: /visualization/ego/initial_candidates
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Queue Size: 10
    - Class: rviz_default_plugins/Marker
      Name: Control Polygon (not the spline curve)
      Enabled: true
      Topic:
        Value: /visualization/ego/control_polygon
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Queue Size: 10
    - Class: rviz_default_plugins/Marker
      Name: AStar (when published upstream)
      Enabled: true
      Topic:
        Value: /visualization/ego/astar
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Queue Size: 10
    - Class: rviz_default_plugins/Marker
      Name: Provisional Hold Envelope
      Enabled: true
      Topic:
        Value: /visualization/ego/hold_envelope
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Queue Size: 10
  - Class: rviz_default_plugins/Image
    Name: D435i RGB
    Enabled: true
    Topic:
      Value: /sensors/d435i/color/image_raw
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: D435i left
    Enabled: true
    Topic:
      Value: /sensors/d435i/infra1/image_rect
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Pitch: 0.6
      Yaw: 3.8
      Focal Point:
        X: 1.5
        Y: 0.0
        Z: 0.5
Window Geometry:
  Width: 1600
  Height: 950
  X: 600
  Y: 80
