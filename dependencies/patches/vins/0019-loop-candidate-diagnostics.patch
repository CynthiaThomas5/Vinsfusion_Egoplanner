+
+void PoseGraph::recordLoopCandidateDiagnostic(KeyFrame* current, KeyFrame* old,
+                                              const LoopVerificationDiagnostics& verification)
+{
+    std::lock_guard<std::recursive_mutex> guard(state_mutex);
+    if (pending_loop_candidate_diagnostics.size() >= 512)
+    {
+        dropped_loop_candidate_diagnostics++;
+        return;
+    }
+    std::ostringstream out;
+    out << std::setprecision(17)
+        << "{\"event\":" << ++loop_candidate_diagnostic_sequence
+        << ",\"current_index\":" << current->index
+        << ",\"current_source_ns\":" << std::llround(current->time_stamp * 1e9)
+        << ",\"old_index\":" << old->index
+        << ",\"old_source_ns\":" << std::llround(old->time_stamp * 1e9)
+        << ",\"minimum_loop_matches\":" << verification.minimum_loop_matches
+        << ",\"descriptor_matches\":" << verification.descriptor_matches
+        << ",\"pnp_ransac_ran\":" << (verification.pnp_ransac_ran ? "true" : "false")
+		<< ",\"pnp_solve_returned_successfully\":";
+	if (verification.pnp_ransac_ran) out << (verification.pnp_solve_returned_successfully ? "true" : "false");
+	else out << "null";
+	out
+        << ",\"pnp_input_matches\":";
+    if (verification.pnp_ransac_ran) out << verification.pnp_input_matches;
+    else out << "null";
+    out << ",\"pnp_inliers\":";
+    if (verification.pnp_ransac_ran) out << verification.pnp_inliers;
+    else out << "null";
+    out << ",\"relative_yaw_deg\":";
+    if (verification.relative_transform_available) out << verification.relative_yaw_deg;
+    else out << "null";
+    out << ",\"relative_translation_m\":";
+    if (verification.relative_transform_available) out << verification.relative_translation_m;
+    else out << "null";
+    out << ",\"yaw_gate_passed\":";
+    if (verification.relative_transform_available) out << (verification.yaw_gate_passed ? "true" : "false");
+    else out << "null";
+    out << ",\"translation_gate_passed\":";
+    if (verification.relative_transform_available) out << (verification.translation_gate_passed ? "true" : "false");
+    else out << "null";
+    out << ",\"accepted\":" << (verification.accepted ? "true" : "false")
+        << ",\"rejection_stage\":\"" << verification.rejection_stage << "\"}";
+    pending_loop_candidate_diagnostics.push_back(out.str());
+}
+
+std::string PoseGraph::takeLoopCandidateDiagnosticsJson()
+{
+    std::lock_guard<std::recursive_mutex> guard(state_mutex);
+    std::ostringstream out;
+    out << "{\"events\":[";
+    for (std::size_t i = 0; i < pending_loop_candidate_diagnostics.size(); ++i)
+    {
+        if (i) out << ",";
+        out << pending_loop_candidate_diagnostics[i];
+    }
+    out << "],\"dropped\":" << dropped_loop_candidate_diagnostics << "}";
+    pending_loop_candidate_diagnostics.clear();
+    dropped_loop_candidate_diagnostics = 0;
+    return out.str();
+}
