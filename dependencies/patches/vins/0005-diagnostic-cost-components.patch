+        };
+        auto evaluate_group = [&problem](const std::vector<ceres::ResidualBlockId> &blocks) {
+            GroupCost result;
+            ceres::Problem::EvaluateOptions evaluate_options;
+            evaluate_options.residual_blocks = blocks;
+            evaluate_options.apply_loss_function = true;
+            for (ceres::ResidualBlockId block : blocks)
+                result.residual_components +=
+                    problem.GetCostFunctionForResidualBlock(block)->num_residuals();
+            result.available = blocks.empty()
+                || problem.Evaluate(evaluate_options, &result.cost, nullptr, nullptr, nullptr);
+            return result;
+        };
+        const GroupCost marginalization_cost = evaluate_group(marginalization_residual_blocks);
