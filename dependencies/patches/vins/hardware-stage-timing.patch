+namespace {
+using HWStageClock = std::chrono::steady_clock;
+void hwStage(const char *name, double stamp, HWStageClock::time_point start) {
+    static const bool enabled = [] { const char *v = std::getenv("VINS_STAGE_TIMING"); return v && std::string(v) == "1"; }();
+    if (enabled) {
+        const auto end = HWStageClock::now();
+        std::fprintf(stderr, "HW_STAGE %s %.9f %.6f %.9f\n", name, stamp,
+            std::chrono::duration<double, std::milli>(end-start).count(),
+            std::chrono::duration<double>(end.time_since_epoch()).count());
+    }
+}
+}
