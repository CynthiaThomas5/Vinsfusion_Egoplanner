+// Read-only diagnostic snapshot; no graph or estimator mutation.
+std::string PoseGraph::diagnosticsJson()
+{
+    std::lock_guard<std::recursive_mutex> guard(state_mutex);
+    std::ostringstream out;
+    out << std::setprecision(17) << "[";
+    bool first = true;
+    for (auto* kf : keyframelist)
+    {
+        if (!first) out << ",";
+        first = false;
+        Vector3d p, v; Matrix3d r, vr;
+        kf->getPose(p,r); kf->getVioPose(v,vr);
+        Quaterniond q(r), vq(vr);
+        out << "{\"index\":" << kf->index << ",\"source_ns\":" << std::llround(kf->time_stamp * 1e9)
+            << ",\"vio_xyz\":[" << v.x() << "," << v.y() << "," << v.z() << "]"
+            << ",\"xyz\":[" << p.x() << "," << p.y() << "," << p.z() << "]"
+            << ",\"q_xyzw\":[" << q.x() << "," << q.y() << "," << q.z() << "," << q.w() << "]"
+            << ",\"vio_q_xyzw\":[" << vq.x() << "," << vq.y() << "," << vq.z() << "," << vq.w() << "]"
+            << ",\"loop_index\":" << (kf->has_loop ? kf->loop_index : -1);
+        if (kf->has_loop) {
+            auto t = kf->getLoopRelativeT(); auto lq = kf->getLoopRelativeQ();
+            out << ",\"loop_relative_t\":[" << t.x() << "," << t.y() << "," << t.z() << "]"
+                << ",\"loop_relative_q_xyzw\":[" << lq.x() << "," << lq.y() << "," << lq.z() << "," << lq.w() << "]";
+        }
+        out << "}";
+    }
+    out << "]"; return out.str();
+}
