diff --git a/include/uxr/client/util/px4_sync_trace.h b/include/uxr/client/util/px4_sync_trace.h
new file mode 100644
index 0000000..5ebd157
--- /dev/null
+++ b/include/uxr/client/util/px4_sync_trace.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: Apache-2.0
+// Diagnostic-only PX4 hooks. Linked by the paired PX4 boundary-trace patch.
+#ifndef UXR_CLIENT_UTIL_PX4_SYNC_TRACE_H
+#define UXR_CLIENT_UTIL_PX4_SYNC_TRACE_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+void px4_sync_trace_enable(uint8_t enabled);
+void px4_sync_trace_begin(uint64_t originate_us, uint64_t begin_us);
+uint8_t px4_sync_trace_waiting(void);
+void px4_sync_trace_finish(void);
+void px4_sync_trace_sent(uint64_t originate_us, uint64_t end_us, uint8_t sent);
+void px4_sync_trace_write(uint64_t begin_us, uint64_t end_us, int32_t bytes);
+void px4_sync_trace_read(uint64_t poll_begin_us, uint64_t poll_end_us,
+                         uint64_t read_begin_us, uint64_t read_end_us, int32_t bytes, int32_t available_before_poll);
+void px4_sync_trace_reply(uint64_t callback_us, uint64_t originate_us,
+                          uint64_t agent_rx_us, uint64_t agent_tx_us);
+#ifdef __cplusplus
+}
+#endif
+#endif
