+plan_env::SweepResult GridMap::certifyCurve(
+    const std::string &epoch, const std::string &map_id, double begin, double end,
+    double speed_bound, const std::function<std::array<double, 3>(double)> &evaluate) const
+{
+  // Serialized callbacks read the last completed fusion, never the pending image.
+  // Keep the exact source/update age and pose gates; pending input does not mutate the grid.
+  const auto reason = queryReadiness(epoch, map_id, false);
+  if (!reason.empty())
+  {
+    plan_env::SweepResult result;
+    result.reason = reason;
+    return result;
+  }
+  return plan_env::certifySweep(begin, end, speed_bound, mp_.obstacles_inflation_,
+      mp_.resolution_, evaluate, [this](auto center, double radius) {
+        return queryRawSphere(center, radius);
+      });
 }
 
