@@ -0,0 +1,65 @@
+#ifndef PLAN_ENV_SWEPT_CURVE_H
+#define PLAN_ENV_SWEPT_CURVE_H
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <string>
+namespace plan_env
+{
+struct SweepResult
+{
+  bool free = false;
+  std::string reason;
+  int checked = 0;
+  double failed_time = 0;
+};
+// A valid speed bound gives |p(t)-p(mid)| <= vmax * dt/2. Enlarging the
+// midpoint sphere by that amount covers every point, including both ends.
+template <class Evaluate, class Query>
+SweepResult certifySweep(double begin, double end, double speed_bound,
+                         double radius, double resolution,
+                         Evaluate evaluate, Query query)
+{
+  SweepResult result;
+  if (!std::isfinite(begin) || !std::isfinite(end) || begin < 0 || end < begin ||
+      !std::isfinite(speed_bound) || speed_bound < 0 ||
+      !std::isfinite(radius) || radius <= 0 ||
+      !std::isfinite(resolution) || resolution <= 0)
+  {
+    result.reason = "invalid_sweep";
+    return result;
+  }
+  const double count = std::max(1.0, std::ceil(speed_bound * (end-begin) / (resolution/4.0)));
+  if (!std::isfinite(count) || count > 10000)
+  {
+    result.reason = "sweep_too_large";
+    return result;
+  }
+  const int intervals = static_cast<int>(count);
+  const double dt = (end-begin)/intervals;
+  const double cover_radius = radius + speed_bound*dt/2.0;
+  for (int index = 0; index < intervals; ++index)
+  {
+    const double mid = begin + (index+.5)*dt;
+    const auto center = evaluate(mid);
+    for (double value : center)
+      if (!std::isfinite(value))
+      {
+        result.reason = "invalid_curve";
+        return result;
+      }
+    const auto sample = query(center, cover_radius);
+    ++result.checked;
+    if (!sample.accepted || sample.reason != "free")
+    {
+      result.reason = sample.reason;
+      result.failed_time = mid;
+      return result;
+    }
+  }
+  result.free = true;
+  result.reason = "free";
+  return result;
+}
+}
+#endif
