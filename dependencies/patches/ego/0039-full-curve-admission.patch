+  bool EGOReplanFSM::certifyLocalCurve(double begin, std::string &reason)
+  {
+    auto info = &planner_manager_->local_data_;
+    auto velocity_points = info->velocity_traj_.getControlPoint();
+    if (velocity_points.cols() == 0 || !velocity_points.allFinite())
+    {
+      reason = "invalid_velocity_bound";
+      return false;
+    }
+    // B-spline derivative is a convex combination of its derivative control points.
+    const double speed_bound = velocity_points.colwise().norm().maxCoeff();
+    const auto result = planner_manager_->grid_map_->certifyCurve(
+        active_goal_epoch_, active_goal_map_id_, begin, info->duration_, speed_bound,
+        [info](double t) {
+          const auto point = info->position_traj_.evaluateDeBoorT(t);
+          return std::array<double, 3>{point(0), point(1), point(2)};
+        });
+    reason = result.reason;
+    return result.free;
+  }
+
+  void EGOReplanFSM::stopForSafety(const std::string &reason)
+  {
+    RCLCPP_ERROR(node_->get_logger(), "Full-curve safety rejected: %s", reason.c_str());
+    uav_interfaces::msg::TrajectoryCancel fault;
+    fault.goal_id = active_goal_id_;
+    fault.epoch = active_goal_epoch_;
+    fault.mode = uav_interfaces::msg::TrajectoryCancel::MODE_ABORT;
+    fault.reason = "full_curve_" + reason;
+    safety_fault_pub_->publish(fault);
+    safety_latched_ = true;
+    have_target_ = false;
+    have_trigger_ = false;
+    have_active_goal_yaw_ = false;
+    have_pending_navigation_goal_ = false;
+    changeFSMExecState(WAIT_TARGET, "FULL_CURVE_SAFETY");
+  }
