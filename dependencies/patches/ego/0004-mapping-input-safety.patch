+bool GridMap::resetMap(const std::string &epoch, const std::string &map_id, std::string &reason)
+{
+  const auto is_hex = [](char value) {
+    return (value >= '0' && value <= '9') || (value >= 'a' && value <= 'f');
+  };
+  if (epoch.size() != 32 ||
+      !std::all_of(epoch.begin(), epoch.end(), is_hex) ||
+      map_id.rfind(epoch + "-", 0) != 0)
+  {
+    reason = "invalid_epoch_or_map_id";
+    return false;
+  }
+
+  const double unknown = mp_.clamp_min_log_ - mp_.unknown_flag_;
+  std::fill(md_.occupancy_buffer_.begin(), md_.occupancy_buffer_.end(), unknown);
+  std::fill(md_.occupancy_buffer_inflate_.begin(), md_.occupancy_buffer_inflate_.end(), 0);
+  std::fill(md_.count_hit_and_miss_.begin(), md_.count_hit_and_miss_.end(), 0);
+  std::fill(md_.count_hit_.begin(), md_.count_hit_.end(), 0);
+  std::fill(md_.flag_rayend_.begin(), md_.flag_rayend_.end(), -1);
+  std::fill(md_.flag_traverse_.begin(), md_.flag_traverse_.end(), -1);
+  decltype(md_.cache_voxel_) empty_cache;
+  md_.cache_voxel_.swap(empty_cache);
+  md_.raycast_num_ = 0;
+  md_.has_first_depth_ = false;
+  md_.has_odom_ = false;
+  md_.has_cloud_ = false;
+  md_.occ_need_update_ = false;
+  md_.local_updated_ = false;
+  md_.flag_depth_odom_timeout_ = false;
+  md_.flag_use_depth_fusion = false;
+  md_.depth_image_.release();
+  md_.last_depth_image_.release();
+  md_.camera_pos_.setZero();
+  md_.last_camera_pos_.setZero();
+  md_.camera_r_m_.setIdentity();
+  md_.last_camera_r_m_.setIdentity();
+  md_.update_num_ = 0;
+  md_.fuse_time_ = 0.0;
+  md_.max_fuse_time_ = 0.0;
+  md_.last_occ_update_time_ = node_->now();
+  mp_.frame_id_ = "odom_" + epoch;
+  resetBuffer();
+  publishMap();
+  publishMapInflate(true);
+
+  reason = "map_cleared:" + map_id;
+  RCLCPP_INFO(node_->get_logger(), "Cleared occupancy map for epoch %s map_id %s",
+              epoch.c_str(), map_id.c_str());
+  return true;
+}
