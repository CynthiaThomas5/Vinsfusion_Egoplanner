+std::string GridMap::queryReadiness(const std::string &epoch, const std::string &map_id) const
+{
+  if (active_epoch_.empty() || active_map_id_.empty())
+  {
+    return "no_active_map";
+  }
+  if (epoch != active_epoch_)
+  {
+    return "epoch_mismatch";
+  }
+  if (map_id != active_map_id_)
+  {
+    return "map_id_mismatch";
+  }
+  if (!md_.has_first_depth_ || !md_.has_fused_depth_ || md_.occ_need_update_)
+  {
+    return "no_fresh_fused_depth";
+  }
+  if (!md_.flag_use_depth_fusion || !md_.last_depth_pose_in_map_ ||
+      md_.flag_depth_odom_timeout_)
+  {
+    return "depth_pose_gate_closed";
+  }
+  const double update_age_s = (node_->now() - md_.last_occ_update_time_).seconds();
+  if (!std::isfinite(update_age_s) || update_age_s < 0.0 ||
+      update_age_s > mp_.odom_depth_timeout_)
+  {
+    return "occupancy_update_stale";
+  }
+  const double source_age_s = node_->now().seconds() -
+                              static_cast<double>(md_.last_fused_depth_source_stamp_ns_) / 1e9;
+  if (md_.last_fused_depth_source_stamp_ns_ <= 0 || !std::isfinite(source_age_s) ||
+      source_age_s < 0.0 || source_age_s > mp_.odom_depth_timeout_)
+  {
+    return "depth_source_stale";
+  }
+
+  return "";
+}
 
