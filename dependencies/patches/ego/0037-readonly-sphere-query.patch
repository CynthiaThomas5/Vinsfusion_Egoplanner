+#ifndef PLAN_ENV_SPHERE_QUERY_H
+#define PLAN_ENV_SPHERE_QUERY_H
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <string>
+
+namespace plan_env
+{
+struct SphereQueryResult
+{
+  bool accepted = false;
+  std::string reason;
+  std::uint32_t unknown = 0, free = 0, occupied = 0;
+};
+
+// Raw cells intersecting the closed sphere, including cell faces. No inflation.
+// Resource bounds are query limits, not a vehicle or collision policy.
+template <class Classify>
+SphereQueryResult querySphere(const std::array<double, 3>& center, double radius,
+                              const std::array<double, 3>& origin,
+                              const std::array<double, 3>& extent,
+                              const std::array<int, 3>& size, double resolution,
+                              Classify classify)
+{
+  SphereQueryResult out;
+  if (!std::isfinite(radius) || radius <= 0 || radius > 2.0 ||
+      !std::isfinite(resolution) || resolution <= 0)
+  {
+    out.reason = "invalid_query";
+    return out;
+  }
+  const double epsilon = 1e-9;  // Conservative allowance for grid face roundoff.
+  std::array<int, 3> lo, hi;
+  std::uint64_t count = 1;
+  for (int axis = 0; axis < 3; ++axis)
+  {
+    if (!std::isfinite(center[axis]) || !std::isfinite(origin[axis]) ||
+        !std::isfinite(extent[axis]) || extent[axis] <= 0 || size[axis] <= 0)
+    {
+      out.reason = "invalid_query";
+      return out;
+    }
+    const double lower = center[axis] - radius, upper = center[axis] + radius;
+    if (lower <= origin[axis] || upper >= origin[axis] + extent[axis])
+    {
+      out.reason = "outside_map";
+      return out;
+    }
+    if (!std::isfinite(extent[axis] / resolution) ||
+        extent[axis] / resolution > static_cast<double>(size[axis]) + epsilon)
+    {
+      out.reason = "invalid_map_geometry";
+      return out;
+    }
+    // Include the adjacent cell even when the sphere only touches its face.
+    lo[axis] = std::max(0, static_cast<int>(std::floor(
+        (lower - origin[axis] - epsilon) / resolution)));
+    hi[axis] = std::min(size[axis] - 1, static_cast<int>(std::floor(
+        (upper - origin[axis] + epsilon) / resolution)));
+    if (hi[axis] < lo[axis])
+    {
+      out.reason = "invalid_map_geometry";
+      return out;
+    }
+    count *= static_cast<std::uint64_t>(hi[axis] - lo[axis] + 1);
+    if (count > 100000)
+    {
+      out.reason = "query_too_large";
+      return out;
+    }
+  }
+  for (int x = lo[0]; x <= hi[0]; ++x)
+    for (int y = lo[1]; y <= hi[1]; ++y)
+      for (int z = lo[2]; z <= hi[2]; ++z)
+      {
+        const std::array<int, 3> index{x, y, z};
+        double distance_squared = 0;
+        for (int axis = 0; axis < 3; ++axis)
+        {
+          const double lower = origin[axis] + index[axis] * resolution;
+          const double upper = lower + resolution;
+          const double distance = std::max({lower - center[axis], 0.0,
+                                            center[axis] - upper});
+          distance_squared += distance * distance;
+        }
+        if (distance_squared > (radius + epsilon) * (radius + epsilon))
+          continue;
+        const int value = classify(x, y, z);
+        if (value < 0) ++out.unknown;
+        else if (value > 0) ++out.occupied;
+        else ++out.free;
+      }
+  out.accepted = true;
+  out.reason = out.occupied ? "occupied" : out.unknown ? "unknown" :
+      out.free ? "free" : "empty_query";
+  return out;
+}
+}
+#endif
