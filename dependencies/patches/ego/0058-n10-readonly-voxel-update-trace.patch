+void GridMap::publishN10VoxelUpdateTrace(std::size_t voxel_count,
+                                        const std::string &updates_json)
+{
+  if (!mp_.n10_voxel_trace_enabled_ || !n10_voxel_update_trace_pub_)
+    return;
+
+  std_msgs::msg::String trace;
+  std::ostringstream data;
+  data.precision(17);
+  data << "{\"schema\":\"n10-voxel-update-trace/v1\",\"phase\":\"fused\","
+       << "\"epoch\":\"" << active_epoch_ << "\",\"map_id\":\""
+       << active_map_id_ << "\",\"callback_count\":" << md_.depth_pose_callback_count_
+       << ",\"fused_count\":" << (md_.fused_depth_count_ + 1)
+       << ",\"image_source_stamp_ns\":" << md_.last_depth_image_stamp_ns_
+       << ",\"pose_source_stamp_ns\":" << md_.last_depth_pose_stamp_ns_
+       << ",\"camera_position_m\":[" << md_.camera_pos_(0) << ","
+       << md_.camera_pos_(1) << "," << md_.camera_pos_(2)
+       << "],\"camera_rotation_row_major\":[";
+  for (int row = 0; row < 3; ++row)
+  {
+    for (int col = 0; col < 3; ++col)
+    {
+      if (row != 0 || col != 0) data << ",";
+      data << md_.camera_r_m_(row, col);
+    }
+  }
+  data << "],\"roi_center_m\":[" << mp_.n10_voxel_trace_center_(0) << ","
+       << mp_.n10_voxel_trace_center_(1) << "," << mp_.n10_voxel_trace_center_(2)
+       << "],\"roi_half_extents_m\":[" << mp_.n10_voxel_trace_half_extents_(0) << ","
+       << mp_.n10_voxel_trace_half_extents_(1) << "," << mp_.n10_voxel_trace_half_extents_(2)
+       << "],\"voxel_count\":" << voxel_count << ",\"updates\":" << updates_json << "}";
+  trace.data = data.str();
+  n10_voxel_update_trace_pub_->publish(trace);
+}
