+  void EGOReplanFSM::fillTaskMetadata(traj_utils::msg::Bspline &bspline,
+                                      const Eigen::MatrixXd &pos_pts,
+                                      double yaw_interval)
+  {
+    bspline.goal_id = active_goal_id_;
+    bspline.epoch = active_goal_epoch_.empty() ? odom_epoch_ : active_goal_epoch_;
+    if (!have_active_goal_yaw_ || pos_pts.cols() < bspline.order + 1 ||
+        !std::isfinite(yaw_interval) || yaw_interval <= 0.0)
+      return;
+
+    const double qx = odom_orient_.x();
+    const double qy = odom_orient_.y();
+    const double qz = odom_orient_.z();
+    const double qw = odom_orient_.w();
+    double previous_yaw = std::atan2(2.0 * (qw * qz + qx * qy),
+                                     1.0 - 2.0 * (qy * qy + qz * qz));
+    Eigen::VectorXd yaw_points(pos_pts.cols());
+    constexpr double TWO_PI = 6.28318530717958647692;
+    for (int i = 0; i < pos_pts.cols(); ++i)
+    {
+      double heading = previous_yaw;
+      if (i + 1 < pos_pts.cols())
+      {
+        const double dx = pos_pts(0, i + 1) - pos_pts(0, i);
+        const double dy = pos_pts(1, i + 1) - pos_pts(1, i);
+        if (std::hypot(dx, dy) > 1e-3)
+          heading = std::atan2(dy, dx);
+        heading += TWO_PI * std::round((previous_yaw - heading) / TWO_PI);
+      }
+      yaw_points(i) = heading;
+      previous_yaw = heading;
+    }
+
+    const int tail_start = std::max(0, int(pos_pts.cols()) - bspline.order);
+    double target_yaw = active_goal_yaw_;
+    target_yaw += TWO_PI * std::round((yaw_points(tail_start) - target_yaw) / TWO_PI);
+    for (int i = tail_start; i < yaw_points.rows(); ++i)
+      yaw_points(i) = target_yaw;
+
+    bspline.yaw_pts.reserve(yaw_points.rows());
+    for (int i = 0; i < yaw_points.rows(); ++i)
+      bspline.yaw_pts.push_back(yaw_points(i));
+    bspline.yaw_dt = yaw_interval;
+  }
