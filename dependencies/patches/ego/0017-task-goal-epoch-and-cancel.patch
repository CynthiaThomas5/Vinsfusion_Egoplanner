+  void EGOReplanFSM::navigationGoalCallback(
+      const std::shared_ptr<const uav_interfaces::msg::NavigationCommand> &msg)
+  {
+    const auto &pose = msg->target.pose;
+    const auto &orientation = pose.orientation;
+    const double q_norm = std::sqrt(orientation.x * orientation.x + orientation.y * orientation.y +
+                                    orientation.z * orientation.z + orientation.w * orientation.w);
+    if (msg->goal_id.empty() || msg->epoch.empty() || !have_odom_ ||
+        msg->epoch != odom_epoch_ || msg->target.header.frame_id != "odom_" + msg->epoch ||
+        !std::isfinite(pose.position.x) || !std::isfinite(pose.position.y) ||
+        !std::isfinite(pose.position.z) || !std::isfinite(q_norm) || q_norm < 1e-9)
+    {
+      RCLCPP_WARN(node_->get_logger(), "Reject navigation goal with invalid id, epoch, frame, or pose");
+      return;
+    }
+
+    const double qx = orientation.x / q_norm;
+    const double qy = orientation.y / q_norm;
+    const double qz = orientation.z / q_norm;
+    const double qw = orientation.w / q_norm;
+    pending_navigation_target_ = Eigen::Vector3d(pose.position.x, pose.position.y, pose.position.z);
+    pending_navigation_yaw_ = std::atan2(2.0 * (qw * qz + qx * qy),
+                                         1.0 - 2.0 * (qy * qy + qz * qz));
+    pending_navigation_goal_id_ = msg->goal_id;
+    pending_navigation_epoch_ = msg->epoch;
+    have_pending_navigation_goal_ = true;
+  }
+
